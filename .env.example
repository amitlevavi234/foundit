# ---------------------------------------------------------------------------
# Foundit — copy to .env.local and fill in. .env.local is never committed.
#
# There is no Vercel and no Supabase. Everything runs on one Hetzner CX23 that
# we own: PostgreSQL 17 in a container bound to 127.0.0.1, the app beside it,
# Cloudflare in front. Production values live in a root-only file on that
# machine, not in any file here and not in a dashboard.
# ---------------------------------------------------------------------------

# Which environment this is. Affects logging and the safety rails.
APP_ENV=development

# --- The database ----------------------------------------------------------
# TWO connection strings, because there are two roles and the difference
# between them is a security boundary, not a formality.
#
# DATABASE_URL is `foundit_app`: owns nothing, no superuser, no BYPASSRLS.
# The application uses it, the eval harness uses it, and the tests use it.
# Connecting as the owner instead silently disables every row-level security
# policy in the schema — and it also lies about performance. A baseline was
# once recorded as the owner and came out at roughly a third of the latency
# the application will actually see (eval/baselines.md).
#
# DATABASE_URL_OWNER is `foundit_owner`: owns the schema, and is the only
# thing that may run a migration. Nothing else should ever use it. Leave it
# unset unless you are applying migrations.
#
# eval/run.mjs reads DATABASE_URL from the process environment and loads no
# .env file of any kind, so set it for the one command rather than leaving it
# in your shell:
#   PowerShell  $env:DATABASE_URL = '...'; node eval/run.mjs
#   bash/zsh    DATABASE_URL='...' node eval/run.mjs
DATABASE_URL=postgresql://REPLACE_APP_USER:REPLACE_APP_PASSWORD@127.0.0.1:5433/foundit_dev
DATABASE_URL_OWNER=postgresql://REPLACE_OWNER_USER:REPLACE_OWNER_PASSWORD@127.0.0.1:5433/foundit_dev
#
# DATABASE_URL_EMBED is `foundit_embed`: the role the embedding job writes
# vectors through (scripts/embed.mjs). Two function grants, no table access,
# and the job refuses to run as anything else. Only needed to run the job.
DATABASE_URL_EMBED=postgresql://REPLACE_EMBED_USER:REPLACE_EMBED_PASSWORD@127.0.0.1:5433/foundit_dev

# --- Sign-in (Better Auth) — Phase 6, not needed before then ---------------
# Google only, plus a 6-digit emailed code. No Apple sign-in.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Embeddings — Phase 3 ---------------------------------------------------
# Server-only. Never prefix a key so a browser can read it. The only outbound
# call the application makes goes to api.openai.com from lib/embeddings.ts;
# the typed sentence (capped at 200 characters) is what leaves the server.
# Without the key, search runs text-only and nothing breaks.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Reading the sentence — Phase 4 ----------------------------------------
# Server-only, and the SAME PROVIDER as the embeddings above: the reader calls
# api.openai.com from lib/reader-model.ts, which is the second and last file in
# the application that opens a socket.
#
# It reads OPENAI_API_KEY first and falls back to EMBEDDINGS_API_KEY. Two names
# and one account, on purpose: requiring a second copy of the same secret in a
# second variable is a second place to leak it from, and the first name is there
# so a deployment that wants a key scoped to this model alone can have one
# without a code change. Leave this blank to use the embeddings key.
#
# Without either, the search runs on the rules pass alone and nothing breaks.
OPENAI_API_KEY=

# --- Spending guards -------------------------------------------------------
# Ceilings the app enforces itself, on top of each provider's own hard cap.
# All three are read at call time with these values as the defaults, so an
# unset, empty, zero or nonsense value is the default rather than no limit.
#
# MAX_SEARCHES_PER_IP_PER_HOUR is a token bucket per visitor, kept in memory,
# keyed on a salted hash of the address that is never stored or logged. Over it,
# the page says so and asks them to come back later.
#
# The two daily caps are global counters, also in memory, taken at the moment a
# paid call is about to be made rather than per search — most searches are cache
# hits and make no call at all. Over one of them, the search still runs, on
# whatever it can do without that call, and nobody sees an error.
MAX_SEARCHES_PER_IP_PER_HOUR=60
MAX_EMBEDDING_CALLS_PER_DAY=2000
MAX_READER_CALLS_PER_DAY=2000

# --- Debugging -------------------------------------------------------------
# Set to 1 to print one line per search with the phase timings — and nothing
# else: no sentence, no address, no key, no result. It is what proves the two
# paid calls overlap rather than queue. Never set in production.
FOUNDIT_TIMELINE=
