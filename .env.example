# ---------------------------------------------------------------------------
# Foundit — copy this file to .env.local and fill it in. Never commit .env.local.
# Production values live in Vercel (Environment Variables), not in any file.
# ---------------------------------------------------------------------------

# Which environment this is. Affects logging and safety rails.
NEXT_PUBLIC_APP_ENV=development

# --- Supabase (the database and sign-in) ----------------------------------
# From your Supabase project: Settings -> API. Use the DEVELOPMENT project here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses every security rule, so it must never reach a browser,
# never be prefixed NEXT_PUBLIC_, and never be committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings (turns text into vectors for the matching) ----------------
# Server-only.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Spending guards ------------------------------------------------------
# Hard ceilings the app enforces itself, on top of each provider's own cap.
MAX_SEARCHES_PER_IP_PER_HOUR=60
MAX_EMBEDDING_CALLS_PER_DAY=2000
