# ---------------------------------------------------------------------------
# Foundit — copy to .env.local and fill in. .env.local is never committed.
#
# There is no Vercel and no Supabase. Everything runs on one Hetzner CX23 that
# we own: PostgreSQL 17 in a container bound to 127.0.0.1, the app beside it,
# Cloudflare in front. Production values live in a root-only file on that
# machine, not in any file here and not in a dashboard.
# ---------------------------------------------------------------------------

# Which environment this is. Affects logging and the safety rails.
APP_ENV=development

# --- The database ----------------------------------------------------------
# TWO connection strings, because there are two roles and the difference
# between them is a security boundary, not a formality.
#
# DATABASE_URL is `foundit_app`: owns nothing, no superuser, no BYPASSRLS.
# The application uses it, the eval harness uses it, and the tests use it.
# Connecting as the owner instead silently disables every row-level security
# policy in the schema — and it also lies about performance. A baseline was
# once recorded as the owner and came out at roughly a third of the latency
# the application will actually see (eval/baselines.md).
#
# DATABASE_URL_OWNER is `foundit_owner`: owns the schema, and is the only
# thing that may run a migration. Nothing else should ever use it. Leave it
# unset unless you are applying migrations.
#
# eval/run.mjs reads DATABASE_URL from the process environment and loads no
# .env file of any kind, so set it for the one command rather than leaving it
# in your shell:
#   PowerShell  $env:DATABASE_URL = '...'; node eval/run.mjs
#   bash/zsh    DATABASE_URL='...' node eval/run.mjs
DATABASE_URL=postgresql://REPLACE_APP_USER:REPLACE_APP_PASSWORD@127.0.0.1:5433/foundit_dev
DATABASE_URL_OWNER=postgresql://REPLACE_OWNER_USER:REPLACE_OWNER_PASSWORD@127.0.0.1:5433/foundit_dev
#
# DATABASE_URL_EMBED is `foundit_embed`: the role the embedding job writes
# vectors through (scripts/embed.mjs). Two function grants, no table access,
# and the job refuses to run as anything else. Only needed to run the job.
DATABASE_URL_EMBED=postgresql://REPLACE_EMBED_USER:REPLACE_EMBED_PASSWORD@127.0.0.1:5433/foundit_dev
#
# DATABASE_URL_AUTH is `foundit_auth`: the ONLY role that may touch the
# auth_core schema, where Better Auth keeps its user, session, account,
# verification and rateLimit tables. It holds nothing anywhere else, and
# foundit_app holds nothing in auth_core — so a SQL-injection bug in the
# catalogue cannot read a session token, and a bug in the authentication
# library cannot read a review. There is no fallback to DATABASE_URL and the
# pool refuses any other role name, for the same reason the other three do.
DATABASE_URL_AUTH=postgresql://REPLACE_AUTH_USER:REPLACE_AUTH_PASSWORD@127.0.0.1:5433/foundit_dev

# --- Sign-in (Better Auth) — Phase 6 ---------------------------------------
# Google, plus a 6-digit code by email. No passwords, no magic links, and not
# the third button the sign-in artboard draws (docs/product-decisions.md §2).
#
# BETTER_AUTH_SECRET signs the session cookie. 32+ random bytes, generated on
# the machine and never typed into a chat window:
#     openssl rand -base64 33 | tr -d '\n/+=' | cut -c1-32
# Without it — or without DATABASE_URL_AUTH — sign-in is switched off: every
# control says so, and searching and browsing work exactly as before.
BETTER_AUTH_SECRET=
#
# Where this deployment lives. The Google redirect URI is built from it, and it
# is what `trustedOrigins` is set to — Better Auth mounts a Route Handler, and
# Next's own security guide is explicit that a Route Handler gets none of the
# Origin checking a Server Action gets.
BETTER_AUTH_URL=http://localhost:3000
#
# From the Google Cloud console. docs/development.md has the exact steps: which
# page, which fields, and the redirect URI, which must match to the character.
# Absent, the Google button is drawn disabled and says so rather than failing
# after the click.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sending the 6-digit code ----------------------------------------------
# Resend (research/09 §6: 3,000 emails a month free, 100 a day, and the
# integration is one variable). RESEND_API_KEY is the key; EMAIL_FROM is the
# sender, which must be an address on a domain Resend has verified — a key with
# an unverified sender fails at the far end where nobody is watching, which is
# why lib/email.ts treats "configured" as needing both.
#
#   EMAIL_FROM=Foundit <no-reply@mail.foundit.tools>
#
# Absent in production, the emailed-code control is drawn disabled and says
# "Email sign-in is not set up yet". Nothing pretends a code was sent.
RESEND_API_KEY=
EMAIL_FROM=
#
# AUTH_DEV_CODE_TO_LOG=1 prints the 6-digit code to the server log instead of
# sending it, so the whole flow can be walked with no provider account and no
# spend. The code is still generated, hashed, stored, expired and verified
# exactly as in production; only the delivery is a console line.
#
# IT NOW FORCES THE LOG EVEN WITH RESEND_API_KEY AND EMAIL_FROM SET, and that
# is a change the Phase 6 review asked for. The check used to sit inside the
# "there is no provider" branch, so on a development machine that had ever
# tested delivery once, this variable was inert and asking for a code put a
# real email in whatever address was typed. Set it and nothing leaves the
# process; LEAVE IT EMPTY when you actually want to test real delivery.
#
# IT CANNOT BE REACHED IN PRODUCTION. lib/email.ts requires NODE_ENV to be
# something other than 'production' AND this to be exactly '1', and
# tests/email.test.mjs asserts that pairing — a deployment that sets this by
# mistake still sends, and still prints nothing. Never set it on the server.
AUTH_DEV_CODE_TO_LOG=

# --- Embeddings — Phase 3 ---------------------------------------------------
# Server-only. Never prefix a key so a browser can read it. The only outbound
# call the application makes goes to api.openai.com from lib/embeddings.ts;
# the typed sentence (capped at 200 characters) is what leaves the server.
# Without the key, search runs text-only and nothing breaks.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Reading the sentence, and ranking what came back — Phases 4 and 5 -----
# Server-only, and the SAME PROVIDER as the embeddings above: the reader calls
# api.openai.com from lib/reader-model.ts, which is the second and last file in
# the application that opens a socket.
#
# It reads OPENAI_API_KEY first and falls back to EMBEDDINGS_API_KEY. Two names
# and one account, on purpose: requiring a second copy of the same secret in a
# second variable is a second place to leak it from, and the first name is there
# so a deployment that wants a key scoped to this model alone can have one
# without a code change. Leave this blank to use the embeddings key.
#
# Phase 5 adds three more calls to the same address with the same key: the
# reranker that judges the candidates a search returned, and the generator and
# verifier behind scripts/generate-statements.mjs. All of them go through
# lib/reader-model.ts, which is still the second and last file in the
# application that opens a socket.
#
# Without either name, the search runs on the rules pass alone, the reranker
# does not run, and the page is the Phase 4 page. Nothing breaks.
OPENAI_API_KEY=

# ===========================================================================
# EVERY LIMIT, IN ONE TABLE (Phase 9a, gate item 7)
#
# The sections below explain each one at length and are where the reasoning
# lives. This is the index: what is bounded, by what, at what, and what it
# costs when somebody hits it. `tests/rate-limit.test.mjs` exceeds every path
# in this table and pastes the refusal.
#
#  PATH               VARIABLE                          DEFAULT  KEYED ON   OVER IT
#  ---------------------------------------------------------------------------------
#  searching          MAX_SEARCHES_PER_IP_PER_HOUR           60  visitor    a page in
#                                                                           the product's
#                                                                           voice, HTTP 200
#  adding a tool      MAX_TOOLS_PER_ACCOUNT_PER_DAY           3  account    a sentence;
#                     MAX_TOOLS_PER_ADDRESS_PER_HOUR         10  visitor    the draft stays
#  editing a listing  MAX_EDITS_PER_ACCOUNT_PER_HOUR         30  account    a sentence;
#                                                                           the edit is not
#                                                                           lost
#  reviewing          MAX_REVIEWS_PER_ACCOUNT_PER_HOUR       10  account    a sentence on
#                                                                           the tool page
#  saving             MAX_SAVES_PER_ACCOUNT_PER_HOUR        120  account    a sentence on
#                                                                           /saved
#  reporting          MAX_REPORTS_PER_ACCOUNT_PER_DAY        10  account    a sentence on
#                     MAX_REPORTS_PER_ADDRESS_PER_HOUR        5  address    /report; the
#                     MAX_REPORTS_PER_SHARED_BUCKET_PER_HOUR 60  global     email is not
#                                                                           sent either
#  the sign-in code   MAX_CODES_PER_ADDRESS_PER_HOUR          5  address    "try again
#                     MAX_CODES_PER_IP_PER_HOUR              20  visitor    later"
#  the click beacon   MAX_OPENS_PER_VISITOR_PER_HOUR         30  visitor    HTTP 204 and
#                     MAX_OPENS_PER_DAY                  20,000  global     nothing counted
#  ---------------------------------------------------------------------------------
#  the model bill     MAX_READER_CALLS_PER_DAY              240  global     the rules pass
#                     MAX_RERANK_CALLS_PER_DAY              120  global     the Phase 4 order
#                     MAX_EMBEDDING_CALLS_PER_DAY         2,000  global     text-only search
#                     MAX_EMBEDDING_TOKENS_PER_DAY    1,500,000  global     the worker waits
#
# THE FIRST SEVEN BOUND BEHAVIOUR AND THE LAST FOUR BOUND MONEY, and the
# difference decides what happens when one is reached. A person over a
# behaviour limit is told, because they can wait; a visitor who happens to
# arrive after the day's model budget is spent has done nothing wrong and is
# shown a slightly worse search with no error at all.
#
# WHAT EVERY ONE OF THEM HAS IN COMMON: the key is a salted hash of the
# address or the account id, the salt is generated per process and written
# down nowhere, the raw value is dropped inside `visitorKey`, nothing is
# persisted, and a restart forgives everybody. A rate limiter is the one part
# of a system that naturally wants to keep a record of who did what and when,
# which is exactly the record this product is built not to have.
#
# AND WHAT THEY DO NOT HAVE: a ceiling that survives a restart, or a second
# process. Those live in the database — the unique index on `tools.url_key`,
# the partial unique index that allows one live review per person per tool,
# `public.embedding_jobs_ceiling()` — and in Cloudflare's own rate-limiting
# rule at the edge (server/cloudflare/README.md), which is the only limit here
# that an attacker's real address is ever compared against.
#
# AND THE FIVE THAT SAY "visitor" ARE ONLY PER VISITOR BEHIND THE TUNNEL. See
# TRUST_CLOUDFLARE_HEADERS immediately below. Unset — which is this file, this
# machine and CI — every one of them is one bucket for all unattributable
# traffic, which is the conservative direction and is now the truth rather
# than a claim.
# ===========================================================================

# --- Who a visitor is ------------------------------------------------------
# Set to 1 ONLY where something in front of this process overwrites
# `cf-connecting-ip` on every request. On the host that is the Cloudflare
# Tunnel, and docs/launch-runbook.md step 1d is the one place it is set.
#
# THE PHASE 9a REVIEW'S F2, AND THIS FILE WAS ONE OF THE THREE PLACES THAT SAID
# THE OPPOSITE. lib/visitor.ts read `cf-connecting-ip`, then `x-real-ip`, then
# `x-forwarded-for`, and returned the first that parsed as an address, with
# nothing checking that the request had come through Cloudflare. The paragraph
# below used to say that traffic reaching the origin directly shares ONE bucket
# "because `x-forwarded-for` can be written by anybody" — and `cf-connecting-ip`
# can be written by anybody too, and was trusted first. The review spent one
# bucket with sixty searches at a forged address and then made forty more from
# forty different forged addresses, refused none of them: a hundred searches,
# zero refusals, one `curl` loop.
#
# So the header is believed only when this says to believe it. Unset, every
# unattributable visitor shares one bucket — one between all of them, not one
# each. `x-real-ip` and `x-forwarded-for` are never read at all, with or
# without this, because nothing in this deployment writes either of them.
#
# tests/rate-limit.test.mjs drives both halves: forty forged addresses with it
# unset are one bucket, and forty with it set are forty.
TRUST_CLOUDFLARE_HEADERS=

# --- Spending guards -------------------------------------------------------
# Ceilings the app enforces itself, on top of each provider's own hard cap.
# All three are read at call time with these values as the defaults, so an
# unset, empty, zero or nonsense value is the default rather than no limit.
#
# MAX_SEARCHES_PER_IP_PER_HOUR is a token bucket per visitor, kept in memory,
# keyed on a salted hash of the address that is never stored or logged. Over it,
# the page says so and asks them to come back later.
#
#   IT HOLDS ONLY WITH CLOUDFLARE IN FRONT, overwriting `cf-connecting-ip` on
#   every request, AND ONLY WITH TRUST_CLOUDFLARE_HEADERS=1 SAYING SO — which
#   is the production arrangement, and the origin has no published port to
#   reach directly. Everything else shares ONE bucket between all of it,
#   because a header can be written by anybody who can reach the socket and
#   trusting one there would let a single client mint a fresh identity per
#   request. And the page it returns is a 200, not a 429: a Next 15 Server
#   Component cannot set a status code, and middleware runs in a different
#   runtime from the in-memory bucket.
#
# The three daily caps are global counters, also in memory, and they count HTTP
# REQUESTS rather than searches — one reading is TWO requests, because the model
# is sampled twice and the samples vote, and one reranker judgement is one. They
# are taken immediately before a call is made, so a cache hit costs nothing
# against them. Over one of them, the search still runs on whatever it can do
# without that call, and nobody sees an error: over the reader's, it runs on the
# rules pass; over the reranker's, it serves the Phase 4 order.
#
# THE NUMBERS ARE COSTED, not chosen, and they are set TOGETHER from one
# number: how many FIRST-EVER searches a day a stranger may make us pay for.
# One search is two reader requests, one rerank request and at most one
# embedding request.
#
# THAT NUMBER IS 120, AND IT WAS 320 UNTIL THE PHASE 5 REVIEW. The cost model
# had been computed from AVERAGE output tokens — 65 for a reading, 206 for a
# judgement. A cap does not bound the average; it bounds the bill, and the
# bill's worst case is a model that reasons to its `max_output_tokens` on every
# call. At the averages the caps cost $4.05 a month and looked comfortable; at
# the ceilings the same caps cost $17.52, which is not a ceiling, it is a hope
# with three decimal places.
#
# IT IS STILL 120, AND THE SAME 120 NOW COSTS A THIRD LESS. This file used to
# name the reader's 900-token output ceiling as the binding constraint on all
# three caps, so the precision work measured the distribution that ceiling
# bounds rather than arguing about it: `scripts/output-tokens.mjs --measure`,
# 396 requests, p99 117 and a maximum of 127. Three times the p99 is 360. The
# reranker's own p99 — printed by every recording run — put its ceiling at 750
# rather than 700, which is the same rule honestly applied in the other
# direction.
#
# THE ARITHMETIC IS ONE TABLE AND IT IS FURTHER DOWN, under
# MAX_EMBEDDING_TOKENS_PER_DAY. This paragraph used to carry a second one of
# its own — three lines totalling $3.23 — which omitted the worker's token
# ceiling and therefore omitted $0.90 of the four lines the test computes. The
# Phase 9a review's F18 found the two tables in this file disagreeing with each
# other by 27%, with the smaller one quoted in the advice.
#
# The embedder keeps a generous number because it costs nothing and because it
# is the one call that still helps when the other two have been spent.
#
# 120 first-ever sentences a day is small, and saying so is better than saying
# 320 from a model that understated the worst case four times over. These bound
# the BILL, not the traffic: a sentence somebody has typed before costs nothing
# against any of them. When there is real traffic, the thing to revisit first is
# these three together — and then MAX_MONTHLY_SPEND in lib/prices.ts, WITH the
# owner, because the headroom under the $5 ceiling is $0.90 and doubling the
# reader and reranker caps would cost about $3.18 more. The output ceilings are
# no longer the place to look: they are measured now, and
# scripts/output-tokens.mjs is how to measure them again.
# MAX_EMBEDDING_TOKENS_PER_DAY IS NEW, AND IT IS THE PHASE 7 REVIEW'S F4. The
# three caps above count HTTP REQUESTS, and for the reader and the reranker a
# request is a request: the prompt is the same length every time. The EMBEDDER
# has two callers and they are not the same size.
#
#   the web process        one capped search sentence — 15 tokens, measured
#   scripts/embed-worker   a BATCH of documents. A summary is capped at 400
#                          characters by 0001 and a statement at 200, so a full
#                          batch of 32 summaries is about 3,200 tokens, which is
#                          213 times the modelled figure.
#
# So the cost model was pricing the worker's requests as if each carried one
# search sentence: at 2,000 requests a day and 3,200 tokens a request, one
# worker is $3.84 a month and the three caps together came to $7.04 against a
# $5 ceiling. The review found two workers running at once on the development
# machine, each holding its own per-process counter, which doubled it again.
#
# A request cap cannot bound that, because the thing that varies is not the
# number of requests. So the embedder has two ceilings:
#
#   MAX_EMBEDDING_CALLS_PER_DAY=2000        requests. What stops a retry storm.
#   MAX_EMBEDDING_TOKENS_PER_DAY=1500000    tokens. What the bill is made of.
#
# THE ONE COST TABLE, and it is the one tests/rate-limit.test.mjs computes. At
# the list prices in lib/prices.ts (read from openai.com on 11 September 2026),
# the fixture's measured input, and every call reasoning to its output ceiling:
#
#   MAX_READER_CALLS_PER_DAY=240            120 readings a day     $1.74 a month
#   MAX_RERANK_CALLS_PER_DAY=120            120 judgements a day   $1.44 a month
#   MAX_EMBEDDING_CALLS_PER_DAY=2000        the web process        $0.02 a month
#   MAX_EMBEDDING_TOKENS_PER_DAY=1500000    the worker             $0.90 a month
#                                                          total   $4.10 a month
#                                                       headroom   $0.90 a month
#
# THE TEST IS THE AUTHORITY AND THIS COMMENT IS NOT: the figures move by a cent
# or two whenever db/seed/embeddings.fixture.json is re-recorded, and the test
# is what fails when they move past $5. It also reads these very lines back and
# fails if they have drifted from what it computes, which is the Phase 9a
# review's F18 — this file carried two tables that disagreed, and the advice
# beside the smaller one would have taken the worst case to about $7.30.
#
# against a ceiling of $5. 1,500,000 tokens is about 15,000 documents a day
# against a catalogue of 224 listings and 504 statements, so the worker is
# bounded by money rather than by work — and tests/rate-limit.test.mjs now
# recomputes the worker's line too, and fails if the total crosses $5.
#
# AND EXACTLY ONE WORKER RUNS. Both counters are per process, so two workers are
# two allowances. scripts/embed-worker.mjs takes a session-level advisory lock
# at start-up and refuses to start if another holds it; docs/development.md has
# the systemd unit.
MAX_SEARCHES_PER_IP_PER_HOUR=60
MAX_EMBEDDING_CALLS_PER_DAY=2000
MAX_EMBEDDING_TOKENS_PER_DAY=1500000
MAX_READER_CALLS_PER_DAY=240
MAX_RERANK_CALLS_PER_DAY=120
#
# The two ceilings on asking for a sign-in code (research/09 §6). They cost
# nothing and they defend different things: five an hour for one ADDRESS
# protects a stranger's inbox and our sending reputation, because anybody who
# knows somebody's address can point this flow at it; twenty an hour for one
# CONNECTION is the enumeration bound, because one script working through a
# list of addresses is one connection here.
#
# NEITHER OF THEM IS WHAT PROTECTS AN ACCOUNT. That is the 3-attempt cap on the
# code itself, in lib/auth.ts: three guesses against a million codes is three
# in a million, and the same code with no attempt cap is guessable by a script
# in minutes. research/09 §6 is blunt about it — the attempt limit is not a
# nicety, it is the entire security of the scheme.
#
# Like the limits above, they are in memory, keyed on a salted hash of the
# address that is never stored or logged, and a restart forgets everybody.
MAX_CODES_PER_ADDRESS_PER_HOUR=5
MAX_CODES_PER_IP_PER_HOUR=20

# --- Adding a tool ---------------------------------------------------------
# How many listings one account may publish in a day, and how many may be
# published from one address in an hour (docs/product-decisions.md §19).
#
# Neither of these is about money. Publishing costs one embedding call per
# statement and MAX_EMBEDDING_CALLS_PER_DAY above already bounds that. These
# bound what a script can do to the CATALOGUE, which a refund does not undo.
#
# Three a day per account is deliberately low: the refusal is recoverable — the
# draft stays and tomorrow it publishes — and raising a limit is easy where
# un-publishing a hundred listings by hand is not. Ten an hour per address is
# the ceiling that survives somebody making accounts, since accounts are free.
#
# Like every limit above they are in memory, keyed on a salted hash that is
# never stored or logged, and a restart forgives everybody. The unique index on
# `public.tools.url_key` is what stops duplicate listings, and that is in the
# database — it was on the raw `url` string until the Phase 7 review found that
# a trailing slash, a `www.`, a capital letter or a `?ref=1` each bought a
# second listing of the same page.
#
# MAX_EDITS_PER_ACCOUNT_PER_HOUR is the third of these and is about neither the
# catalogue nor the bill directly: every statement edit writes a row to
# public.embedding_jobs, and until the review nothing bounded how often. Thirty
# an hour is one save every two minutes for an hour, which is generous for a
# person correcting a listing and nothing at all for a script. The refusal is a
# sentence on the page they are already on and the listing is untouched. The
# ceiling that survives a restart is public.embedding_jobs_ceiling() — 5,000
# rows, past which the edit is still saved, the re-embed is declined with a
# line in the log, and the work predicates in 0005 and 0007 pick it up on the
# next sweep of scripts/embed.mjs.
MAX_TOOLS_PER_ACCOUNT_PER_DAY=3
MAX_TOOLS_PER_ADDRESS_PER_HOUR=10
MAX_EDITS_PER_ACCOUNT_PER_HOUR=30

# --- Reviewing, and saving -------------------------------------------------
# Phase 9a, gate item 7. These two write paths had no bound at all, and unlike
# every other limit in this file that was not because something went wrong —
# nobody had asked. research/03 §9 item 14 names the first of them outright
# ("review 10/hour per user").
#
# Neither is about money: a review is one row and a save is one row, and no
# paid call is made by either. They are about what a script with a free
# account can do to a PAGE. Every post of a review is an UPSERT that bumps
# `tools.rating_count` and invalidates the catalogue cache for that listing;
# every save bumps `tools.save_count` and writes a `collection_items` row.
#
# Ten reviews an hour is beyond what a person writes. A hundred and twenty
# saves is deliberately generous, because saving is the one thing people
# genuinely do in bursts — a page of twenty results, saved one at a time,
# twice over, is eighty.
#
# OVER THE REVIEW LIMIT, THE REFUSAL IS A SENTENCE ON THE PAGE AND THE REVIEW
# THEY TYPED IS STILL IN THE FORM — and lib/review-draft.ts is what makes both
# halves of that true. This file used to claim them and neither held: the
# notice URL was built by concatenating `?review=` onto a path that already
# carried `?q=<the sentence>`, so the marker became part of the search and the
# notice never rendered, and a `redirect()` re-renders the page from the
# server, where there was no draft to restore from. That is the Phase 9a
# review's F12. The draft now waits in a five-minute httpOnly cookie scoped to
# the one listing, and it is deleted the moment a review is written.
#
# BOTH ARE PER ACCOUNT AND NOT PER ADDRESS, and accounts are free, which is
# the honest weakness. What is behind them is in the database and survives a
# restart: the partial unique index that allows one live review per person per
# tool, and `collection_items`' own primary key.
MAX_REVIEWS_PER_ACCOUNT_PER_HOUR=10
MAX_SAVES_PER_ACCOUNT_PER_HOUR=120

# --- The click out to a maker's site ---------------------------------------
# The two ceilings on `POST /o`, which is the only thing that moves
# `tools.open_count` (docs/product-decisions.md §12, app/o/route.ts).
#
# THE PHASE 8 REVIEW'S F5. The count shipped with no bound at all: 200
# anonymous posts moved the counter by 146 in 23 seconds and starved the pool
# that renders pages while they ran, and 5,000 calls at the SQL layer took 19
# seconds. Nothing anywhere orders on open_count — /top orders on likes, saves
# and rating — so inflating it moves no listing up a page; what it costs is a
# pooled connection and a row version on the catalogue's busiest table, which
# is enough.
#
# Thirty an hour is the honest upper bound on a person: every result on a page
# of twenty, opened twice. The daily cap is the backstop the per-visitor limit
# cannot see — a thousand addresses making thirty each — and 20,000 against a
# catalogue of 224 listings is far above any real day.
#
# Both come out of the same in-memory bucket map as every limit above, keyed on
# a salted hash of the address that is never stored or logged, so nothing new
# is written down anywhere. Over either ceiling the route answers 204 and
# counts nothing: it answers 204 to everything, because a status code that
# varies is an oracle.
MAX_OPENS_PER_VISITOR_PER_HOUR=30
MAX_OPENS_PER_DAY=20000

# --- Filing a report -------------------------------------------------------
# The three ceilings on /report, which since 14 September 2026 WRITES a row as
# well as sending an email (docs/product-decisions.md §4,
# db/migrations/0023_reports.sql).
#
# ONE REPORTER IS JUDGED BY ONE OF THEM, which is the shape since the round-1
# review (F5) and was not before: the address bucket used to be spent first for
# everybody, so a signed-in account could be refused because a stranger had
# spent it.
#
# TEN PER ACCOUNT PER DAY judges a SIGNED-IN reporter, and nothing else does. A
# day rather than an hour on purpose: a report is a thing a person reads, and a
# hundred of them from one account is not moderation, it is a way of burying
# the ones that matter. Somebody with a genuine list of ten things to report
# today can send the eleventh tomorrow.
#
# FIVE PER ADDRESS PER HOUR judges a SIGNED-OUT reporter whose address is
# known, which means TRUST_CLOUDFLARE_HEADERS is set and something in front of
# this process overwrites the header. Reporting is open to a signed-out
# visitor: a sign-in wall in front of "this listing is wrong" is a wall in
# front of the reports most worth having, and the price of not having one is
# that the address is the only thing a bound can be attached to.
#
# SIXTY PER HOUR FOR THE SHARED BUCKET, which is everybody whose address is not
# known — every visitor, on a deployment with TRUST_CLOUDFLARE_HEADERS unset.
# It is a bound on OUR mail server and moderation queue rather than on a
# person, which is why it is twelve times the per-address number: five an hour
# between the whole internet meant one stranger could close the notice
# mechanism for twelve minutes with one request.
#
# All three gate the EMAIL as well as the row, so none of them can be used to
# make our mail server send a hundred messages. Over a ceiling the page says so
# in a sentence and keeps what was typed.
MAX_REPORTS_PER_ADDRESS_PER_HOUR=5
MAX_REPORTS_PER_ACCOUNT_PER_DAY=10
MAX_REPORTS_PER_SHARED_BUCKET_PER_HOUR=60

# --- Debugging -------------------------------------------------------------
# Set to 1 to print one line per search with the phase timings — and nothing
# else: no sentence, no address, no key, no result. It is what proves the two
# paid calls overlap rather than queue. Never set in production.
FOUNDIT_TIMELINE=
