# ===========================================================================
# /root/.foundit/backup.env — copy this, fill it in ON THE HOST, mode 0600.
#
# THIS FILE IS THE EXAMPLE AND HOLDS NO VALUE. The real one is created by the
# owner in 9b (docs/launch-runbook.md step 1) and is never committed, never
# printed and never passed as a command-line argument — an argument is visible
# in `ps` to every user on the box, which is the same reason
# server/setup/09-postgres-service.sh feeds passwords over stdin.
#
# Both scripts in this directory read it with `set -a; . backup.env; set +a`
# and neither ever echoes a line of it. tests/deploy.test.mjs runs them with a
# fake one full of recognisable values and greps every line of their output.
# ===========================================================================

# --- WHERE THE DUMPS GO ----------------------------------------------------
#
# TWO KINDS OF REPOSITORY, AND EXACTLY ONE OF THEM IS SET.
#
#   BACKUP_REPO_PATH    a directory. What the development machine uses, and
#                       what a second on-box copy would use. Set this and the
#                       S3 settings below are ignored entirely.
#   BACKUP_S3_BUCKET    Cloudflare R2, over the S3 API. What the server uses.
#
# The filesystem repository is not a toy: research/10 §4.3's three tiers are
# pre-deploy on-box, nightly off-box, and a whole-disk snapshot, and this is
# how the first of the three is written. It is also how the whole chain —
# dump, verify, restore, count, record — is exercised here, where there is no
# R2 bucket and no credential to put in one.
#BACKUP_REPO_PATH=/srv/foundit/backups/logical

BACKUP_S3_BUCKET=foundit-pgbackrest
BACKUP_S3_PREFIX=logical-dumps
# R2's endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com, its region is
# the literal string `auto`, and it wants path-style URIs (research/08 §5.3).
BACKUP_S3_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY

# --- ENCRYPTION ------------------------------------------------------------
#
# THE PUBLIC HALF ONLY. research/08 §5.4: the private key is generated on the
# owner's laptop with `age-keygen` and stays in a password manager, and only
# the recipient (public) half is written here. The property that buys is worth
# stating plainly: **the server can create backups it cannot itself read.**
# Root on the box can write tomorrow's dump and cannot decrypt last week's.
#
# UNSET MEANS THE SCRIPT WILL NOT UPLOAD AT ALL. It writes a plaintext archive
# to a LOCAL DIRECTORY and says so out loud — which is correct on the
# development machine, where the database holds invented data and the
# repository is a directory on the same disk, and where encrypting it would
# protect it from somebody who already has it. To a BUCKET it refuses outright
# and exits 78.
#
# THAT USED TO BE A WARNING THAT SCROLLED PAST, and nothing in the launch path
# set this variable: `docs/launch-runbook.md` never generated the key,
# `age-keygen` appeared nowhere in docs/ or server/, and the checklist item
# this file and the script both cited for enforcement — item 24 — is about a
# privacy notice and says nothing about backups. Following the runbook
# literally put a plaintext tar holding `pg_dumpall --globals-only` (every role
# and every grant) and the whole database into R2. That is the Phase 9a
# review's F7.
#
# The key pair is generated in `docs/launch-runbook.md` step 1d and checked as
# `docs/launch-checklist.md` **item 41**.
#DUMP_AGE_RECIPIENT=age1REPLACE_WITH_THE_PUBLIC_HALF

# --- HOW LONG TO KEEP THEM -------------------------------------------------
# Fourteen days of logical dumps (research/08 §5.4). The pgBackRest repository
# keeps four weekly fulls and seven differentials, which is a different and
# longer window, on purpose: the two backups fail in different ways and are
# kept to different rules so that one failure mode cannot take both.
BACKUP_KEEP_DAYS=14

# --- THE DEAD MAN'S SWITCH -------------------------------------------------
#
# Pinged ONLY on complete success, never on failure. research/08 §5.8's
# argument, which is the whole reason it is this way round: a script that
# emails on failure stops protecting you the moment the script itself stops
# running, and silence then feels like success. Pinging on success collapses
# every failure mode — including "never ran" — into one alert.
#
# Unset means no ping, which is the state on this machine.
#BACKUP_PING_URL=https://hc-ping.com/REPLACE_WITH_THE_UUID
#RESTORE_TEST_PING_URL=https://hc-ping.com/REPLACE_WITH_THE_OTHER_UUID
