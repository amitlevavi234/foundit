{
  "name": "foundit",
  "version": "0.0.0",
  "private": true,
  "description": "Foundit — describe a problem, get the tools that fit.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "eval": "node eval/run.mjs",
    "eval:json": "node eval/run.mjs --json",
    "eval:baseline": "node eval/run.mjs --baseline --json",
    "eval:read-query": "node eval/run.mjs --read-query",
    "calibrate": "node eval/calibrate.mjs",
    "eval:no-rerank": "node eval/run.mjs --no-rerank",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "node eval/scoring.test.mjs && node --test tests/*.test.mjs && node eval/run.mjs --baseline",
    "test:db": "bash db/test.sh",
    "test:all": "node eval/scoring.test.mjs && node --test tests/*.test.mjs && bash db/test.sh && node eval/run.mjs --baseline"
  },
  "dependencies": {
    "better-auth": "^1.7.4",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
