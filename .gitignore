# dependencies
node_modules/
.pnp/
.pnp.js

# eval harness output — every run writes a new timestamped file, and the
# numbers that matter are transcribed into eval/baselines.md by hand
eval/results/

# ...but eval/recordings/ IS committed. It holds one small JSON per recording
# the baselines table cites — the spread, the per-query numbers, the coverage —
# because a number in a table with nothing behind it is a claim, and the Phase 5
# review was right that five recordings nobody can open are not five recordings.
!eval/recordings/

# builds
.next/
out/
build/
dist/

# environment — never commit real values
.env
.env.local
.env.*.local
.env.production
!.env.example

# supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# logs and caches
*.log
npm-debug.log*
.turbo/
.vercel/
.cache/
coverage/

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
db/.data/

# typescript / next build metadata
*.tsbuildinfo
next-env.d.ts
